# Systemd service file for Nutrition Game
# Location: /etc/systemd/system/nutritiongame.service
#
# Install:
#   sudo cp nutritiongame.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable nutritiongame
#   sudo systemctl start nutritiongame
#
# Logs:
#   sudo journalctl -u nutritiongame -f

[Unit]
Description=Nutrition5k Annotation Game
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/nutritiongame
Environment="BLIND_MODE=1"
Environment="PORT=5100"
ExecStart=/usr/bin/python3 /home/ubuntu/nutritiongame/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
